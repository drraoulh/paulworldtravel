# Copy these into Vercel (Project → Settings → Environment Variables) or Netlify
# (Site configuration → Environment variables). Never commit real values.

# Brevo API v3 key: Brevo → SMTP & API → API keys
BREVO_API_KEY=
# Sender address validated in Brevo (Senders, domains & dedicated IPs)
BREVO_SENDER_EMAIL=
# Optional
BREVO_SENDER_NAME=Paul World Travel
CONTACT_TO_EMAIL=paulworld2016@yahoo.com
