# Brevo (emails d'inscription)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=infos@paulworldtravel.com
BREVO_SENDER_NAME=PAULWORLD TRAVEL
SIGNUP_TO_EMAIL=infos@paulworldtravel.com,paulworld2016@yahoo.com

# Supabase (Project Settings > API) : URL et clé publique "anon" / "publishable"
NEXT_PUBLIC_SUPABASE_URL=https://losobefiezietwpurwok.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète Supabase (Project Settings > API Keys > Secret keys), serveur uniquement
SUPABASE_SECRET_KEY=

# IA économique : clé OpenAI serveur uniquement (ne jamais utiliser NEXT_PUBLIC_)
# Prioritaire si renseignée. Sans cette clé, les fournisseurs existants restent utilisés.
OPENAI_API_KEY=
# Valeurs par défaut, configurables :
# OPENAI_MODEL_GRADING=gpt-6-luna
# OPENAI_MODEL_FAST=gpt-6-luna
# OPENAI_MODEL_TRANSCRIPTION=gpt-transcribe

# Alternative existante pour le texte, utilisée seulement en l’absence de clé OpenAI
OPENROUTER_API_KEY=
# OPENROUTER_MODEL_GRADING=google/gemini-3.8-flash
# OPENROUTER_MODEL_FAST=google/gemini-3.5-flash-lite
# Sans OpenAI, l’oral nécessite aussi un jeton Hugging Face :
# HF_TOKEN=
# HF_WHISPER_MODEL=openai/whisper-large-v3-turbo

# Images et audios des séries sous licence. Vide : stockage du vendeur (voir src/lib/media.ts).
