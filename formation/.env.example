# Brevo (emails d'inscription)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=infos@paulworldtravel.com
BREVO_SENDER_NAME=PAULWORLD TRAVEL
SIGNUP_TO_EMAIL=infos@paulworldtravel.com,paulworld2016@yahoo.com

# Supabase (Project Settings > API) : URL et clé publique "anon" / "publishable"
NEXT_PUBLIC_SUPABASE_URL=https://losobefiezietwpurwok.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Ancienne variable NEXT_PUBLIC_SUPABASE_ANON_KEY également prise en charge.

# Clé secrète Supabase (Project Settings > API Keys > Secret keys), serveur uniquement
SUPABASE_SECRET_KEY=

# IA : une seule clé OpenRouter suffit (correction, tuteur, transcription de l'oral)
OPENROUTER_API_KEY=
# Optionnel : modèles (par défaut, les moins chers)
# OPENROUTER_MODEL_GRADING=google/gemini-3.8-flash   (plus précis : anthropic/claude-sonnet-5.5)
# OPENROUTER_MODEL_FAST=google/gemini-3.5-flash-lite
# OPENROUTER_MODEL_AUDIO=google/gemini-3.8-flash
# Optionnel : transcription par Whisper sur Hugging Face au lieu d'OpenRouter
# HF_TOKEN=
